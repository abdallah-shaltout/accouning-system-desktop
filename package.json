{
  "name": "accounting-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "stop": "node scripts/stop-dev.js",
    "desktop": "node scripts/stop-dev.js && tauri dev",
    "scaffold": "node scripts/scaffold.js",
    "build:android": "cd src-tauri/gen/android && ./gradlew.bat assembleArm64Debug",
    "verify:mocks": "bun run scripts/verify/run.ts",
    "verify:replay": "bun run scripts/verify/replay.ts",
    "check": "node scripts/check-text-tokens.js && node scripts/check-rtl.js && bun run scripts/check-contrast.ts && node scripts/check-ui-rules.js",
    "memory": "bun run scripts/memory/run.ts",
    "memory:check": "bun run scripts/memory/run.ts --check",
    "diag": "bun run scripts/diagnostics/run.ts",
    "diag:check": "bun run scripts/diagnostics/run.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^15.0.0",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "libphonenumber-js": "^1.13.13",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
