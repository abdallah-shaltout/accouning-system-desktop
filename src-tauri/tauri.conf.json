{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "accounting-app",
  "version": "0.1.0",
  "identifier": "com.abdallah.accounting-app",
  "build": {
    "beforeDevCommand": "node scripts/fetch-webview2.js && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-webview2.js && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "نظام المحاسبة ونقاط البيع",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime.153.0.4234.48.x64/"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
