# Copy to .env and fill in real values. Never commit .env.
# See docs/07-environment.md for the full description of every key.

NODE_ENV=                          # DEV or PROD
PORT=                              # Coolify sets this in PROD
SERVER_BASE=                       # e.g. https://api.farook.app

# PostgreSQL (Drizzle). Name kept from the reference server.
DB_URL=                            # postgres://user:pass@host:port/equal_dev
TEST_DB_URL=                       # postgres://user:pass@host:port/equal_test (must end in _test)

# Redis
REDIS_URI=                         # redis://localhost:6379
REDIS_TLS=                         # true/false
TEST_REDIS_URI=                    # redis://localhost:6379/1

# JWT / cookies
JWT_SECRET_KEY=
JWT_EXPIRE_TIME=                   # 15m
JWT_REFRESH_SECRET_KEY=
JWT_REFRESH_EXPIRE_TIME=           # 30d
COOKIE_PARSER_SECRET_KEY=
DATA_ENCRYPTION_KEY=               # 32-byte base64 key, encrypts admin TOTP secrets

# CORS / portal
ALWED_WEBSITE=                     # comma-separated allowed origins, e.g. https://app.farook.app
PORTAL_URL=                        # https://app.farook.app

# Idempotency (optional, reference defaults apply if unset)
IDEMPOTENCY_TTL_SECONDS=
IDEMPOTENCY_PENDING_TTL_SECONDS=
IDEMPOTENCY_ENABLED=

# WhatsApp OTP (GOWA) — required in PROD, DEV uses a console adapter
GOWA_BASE_URL=
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASSWORD=

# License signing (Ed25519). Generate with `bun run keys:generate`.
LICENSE_ACTIVE_KID=
LICENSE_SIGNING_KEY_dev-1=

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RELEASES=
R2_PUBLIC_RELEASES_URL=
R2_BUCKET_PRIVATE=

PAYMENT_INSTRUCTIONS_JSON=         # JSON: InstaPay handle, wallet number, bank details

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Tests only
TEST_DB_URL=
TEST_REDIS_URI=
