{
  "name": "equal-backend",
  "version": "0.0.1",
  "description": "Equal subscription, licensing and operations server (Express + TypeScript + PostgreSQL + Redis).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/index.js",
    "start:debug": "node --inspect dist/index.js",
    "build": "rimraf dist && tsx build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write ./src",
    "plop": "plop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/config/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/config/seeders/index.ts",
    "keys:generate": "tsx src/shared/security/generateKeys.ts",
    "catalog:export": "tsx src/domains/plan/schema/exportCatalog.ts"
  },
  "lint-staged": {
    "*.{js,ts}": ["tsc --noEmit"]
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.832.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "@noble/ed25519": "^2.1.0",
    "argon2": "^0.41.1",
    "axios": "^1.12.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.2.0",
    "hpp": "^0.2.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "otpauth": "^9.3.4",
    "pg": "^8.13.1",
    "phone": "^3.1.58",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^8.0.1",
    "sort-keys": "^6.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/ui": "2.1.9",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.28.0",
    "esbuild": ">=0.25.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.1",
    "prettier": "^3.1.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.8",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
